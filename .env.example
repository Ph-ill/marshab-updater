# Local deployment settings for docker-compose.yml.
# Copy to .env (untracked, listed in .gitignore) or set the same variables in your
# Portainer stack's environment. Never commit the real .env.

# Loopback port published on the Docker host (127.0.0.1:<port> -> container :80).
# The public site does not use it: the reverse proxy reaches the container over the
# external docker network "Shared". Pick any free port on your host.
MARSHAB_HOST_PORT=8080
